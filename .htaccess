<IfModule mod_rewrite.c>
RewriteEngine On

# Generate the public sitemap from sitemap.php while keeping /sitemap.xml stable.
RewriteRule ^sitemap\.xml$ sitemap.php [L,NC]

# Use one canonical host and protocol for every public URL.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.singhaniarefrigeration\.com$ [NC]
RewriteRule ^ https://singhaniarefrigeration.com%{REQUEST_URI} [R=301,L,NE]

# Redirect legacy filenames/short slugs directly to their preferred SEO URLs.
# THE_REQUEST prevents these redirects from firing after an internal rewrite.
RewriteCond %{THE_REQUEST} \s/+truck-ac(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^truck-ac(?:\.php)?$ /truck-ac-manufacturer-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+truck-refrigerator-container(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^truck-refrigerator-container(?:\.php)?$ /truck-refrigerator-container-manufacturer-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+cold-storage-refrigeration-units(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^cold-storage-refrigeration-units(?:\.php)?$ /cold-storage-refrigeration-units-manufacturer-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+compressor-rack-system(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^compressor-rack-system(?:\.php)?$ /compressor-rack-system-manufacturer-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+ammonia-refrigeration-units(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^ammonia-refrigeration-units(?:\.php)?$ /ammonia-refrigeration-units-manufacturer-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+freon-refrigeration-units(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^freon-refrigeration-units(?:\.php)?$ /freon-refrigeration-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+ripening-systems(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^ripening-systems(?:\.php)?$ /ripening-systems-manufacturer-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+multideck-cabinet(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^multideck-cabinet(?:\.php)?$ /multideck-cabinet-manufacturer-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+iqf(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^iqf(?:\.php)?$ /iqf-system-manufacturer-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+doors-ca-doors(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^doors-ca-doors(?:\.php)?$ /cold-storage-doors-manufacturer-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+panels(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^panels(?:\.php)?$ /puf-panels-manufacturer-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+dock-shelter-dock-leveler(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^dock-shelter-dock-leveler(?:\.php)?$ /dock-shelter-dock-leveler-manufacturer-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+heavy-duty-racks(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^heavy-duty-racks(?:\.php)?$ /heavy-duty-racks-manufacturer-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+turnkey-solution(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^turnkey-solution(?:\.php)?$ /turnkey-cold-storage-solutions-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+segments-wise(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^segments-wise(?:\.php)?$ /segment-wise-cold-storage-solutions-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+cold-chain-refrigeration-ca-store-freon-ammonia(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^cold-chain-refrigeration-ca-store-freon-ammonia(?:\.php)?$ /cold-chain-refrigeration-ca-store-freon-ammonia-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+quality-monitoring-solution(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^quality-monitoring-solution(?:\.php)?$ /cold-chain-quality-monitoring-solution-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+ware-house-management(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^ware-house-management(?:\.php)?$ /warehouse-management-solutions-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+transport-management(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^transport-management(?:\.php)?$ /transport-management-solutions-in-india [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+transport-refrigeration(?:\.php)?(?:[?\s]) [NC]
RewriteRule ^transport-refrigeration(?:\.php)?$ /transport-refrigeration-solutions-in-india [R=301,L,NE]

# SEO aliases internally serve the existing PHP files.
RewriteRule ^product&services/?$ products.php [L,NC]
RewriteRule ^truck-ac-manufacturer-in-india/?$ truck-ac.php [L,NC]
RewriteRule ^truck-refrigerator-container-manufacturer-in-india/?$ truck-refrigerator-container.php [L,NC]
RewriteRule ^cold-storage-refrigeration-units-manufacturer-in-india/?$ cold-storage-refrigeration-units.php [L,NC]
RewriteRule ^compressor-rack-system-manufacturer-in-india/?$ compressor-rack-system.php [L,NC]
RewriteRule ^ammonia-refrigeration-units-manufacturer-in-india/?$ ammonia-refrigeration-units.php [L,NC]
RewriteRule ^freon-refrigeration-in-india/?$ freon-refrigeration-units.php [L,NC]
RewriteRule ^ripening-systems-manufacturer-in-india/?$ ripening-systems.php [L,NC]
RewriteRule ^multideck-cabinet-manufacturer-in-india/?$ multideck-cabinet.php [L,NC]
RewriteRule ^iqf-system-manufacturer-in-india/?$ iqf.php [L,NC]
RewriteRule ^cold-storage-doors-manufacturer-in-india/?$ doors-ca-doors.php [L,NC]
RewriteRule ^puf-panels-manufacturer-in-india/?$ panels.php [L,NC]
RewriteRule ^dock-shelter-dock-leveler-manufacturer-in-india/?$ dock-shelter-dock-leveler.php [L,NC]
RewriteRule ^heavy-duty-racks-manufacturer-in-india/?$ heavy-duty-racks.php [L,NC]

RewriteRule ^turnkey-cold-storage-solutions-in-india/?$ turnkey-solution.php [L,NC]
RewriteRule ^segment-wise-cold-storage-solutions-in-india/?$ segments-wise.php [L,NC]
RewriteRule ^cold-chain-refrigeration-ca-store-freon-ammonia-in-india/?$ cold-chain-refrigeration-ca-store-freon-ammonia.php [L,NC]
RewriteRule ^cold-chain-quality-monitoring-solution-in-india/?$ quality-monitoring-solution.php [L,NC]
RewriteRule ^warehouse-management-solutions-in-india/?$ ware-house-management.php [L,NC]
RewriteRule ^transport-management-solutions-in-india/?$ transport-management.php [L,NC]
RewriteRule ^transport-refrigeration-solutions-in-india/?$ transport-refrigeration.php [L,NC]

# Consolidate the homepage at the canonical root URL.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ / [R=301,L]

# Redirect direct requests for public PHP pages to extensionless URLs.
# Shared includes, form handlers and the admin area intentionally keep .php.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+[^\s?]*\.php(?:[?\s]) [NC]
RewriteRule ^(?!(?:admin/|head\.php$|header\.php$|footer\.php$|whatsapp-float\.php$|chat-box\.php$|enquirypopup\.php$|form-handler\.php$))(.+)\.php$ /$1 [R=301,L,NE]

# Serve WebP automatically when the browser supports it and a matching file exists.
RewriteCond %{HTTP_ACCEPT} image/webp
RewriteCond %{REQUEST_URI} ^(.+)\.(jpe?g|png)$
RewriteCond %{DOCUMENT_ROOT}%1.webp -f
RewriteRule ^(.+)\.(jpe?g|png)$ $1.webp [T=image/webp,E=serve_webp:1,L]

# Internally serve /about-us from /about-us.php (and the same for public pages).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(?!(?:admin/|head$|header$|footer$|whatsapp-float$|chat-box$|enquirypopup$|form-handler$))(.+)$ $1.php [L]
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net https://www.google-analytics.com https://singhanialogistics.in https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://connect.facebook.net https://www.facebook.com https://www.googletagmanager.com https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://singhanialogistics.in; frame-src https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self';"
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Strict-Transport-Security "max-age=86400; includeSubDomains"

  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header append Vary Accept env=serve_webp
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
