<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Under Maintenance</title>

  <!-- Google Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Font Awesome CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"/>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      overflow: hidden;
      position: relative;
    }

    .background-circle {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.25;
      z-index: 0;
      animation: float 8s ease-in-out infinite;
    }

    .circle1 {
      width: 260px;
      height: 260px;
      background: #38bdf8;
      top: 8%;
      left: 8%;
    }

    .circle2 {
      width: 220px;
      height: 220px;
      background: #22c55e;
      bottom: 10%;
      right: 10%;
      animation-delay: 2s;
    }

    .circle3 {
      width: 180px;
      height: 180px;
      background: #f59e0b;
      top: 55%;
      left: 50%;
      transform: translate(-50%, -50%);
      animation-delay: 4s;
    }

    @keyframes float {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-20px);
      }
    }

    .maintenance-box {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 700px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-radius: 24px;
      padding: 50px 35px;
      text-align: center;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    }

    .icon {
      width: 90px;
      height: 90px;
      margin: 0 auto 24px;
      border-radius: 20px;
      background: rgba(255,255,255,0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 38px;
      color: #38bdf8;
      border: 1px solid rgba(255,255,255,0.14);
    }

    h1 {
      color: #ffffff;
      font-size: 38px;
      font-weight: 700;
      margin-bottom: 14px;
    }

    p {
      color: #cbd5e1;
      font-size: 17px;
      line-height: 1.8;
      max-width: 560px;
      margin: 0 auto 18px;
    }

    .highlight {
      color: #7dd3fc;
      font-weight: 600;
    }

    .status {
      display: inline-block;
      margin-top: 15px;
      padding: 10px 18px;
      border-radius: 999px;
      background: rgba(34, 197, 94, 0.12);
      border: 1px solid rgba(34, 197, 94, 0.25);
      color: #86efac;
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.4px;
    }

    .dots {
      display: inline-block;
      min-width: 24px;
      text-align: left;
    }

    .footer-text {
      margin-top: 24px;
      font-size: 14px;
      color: #94a3b8;
    }

    @media (max-width: 768px) {
      .maintenance-box {
        padding: 35px 22px;
        border-radius: 18px;
      }

      h1 {
        font-size: 30px;
      }

      p {
        font-size: 15px;
      }

      .icon {
        width: 75px;
        height: 75px;
        font-size: 30px;
      }
    }

    @media (max-width: 480px) {
      h1 {
        font-size: 26px;
      }

      p {
        font-size: 14px;
        line-height: 1.7;
      }

      .status {
        font-size: 13px;
        padding: 9px 14px;
      }
    }
  </style>
</head>
<body>

  <div class="background-circle circle1"></div>
  <div class="background-circle circle2"></div>
  <div class="background-circle circle3"></div>

  <div class="maintenance-box">
    <div class="icon">
      <i class="fa-solid fa-screwdriver-wrench"></i>
    </div>

    <h1>Under Maintenance</h1>

    <p>
      We are currently <span class="highlight">upgrading our website</span> to serve you better.
    </p>

    <p>
      Our website is in <span class="highlight">maintenance mode</span> right now.
      We will be back soon<span class="dots" id="dots">.</span>
    </p>

    <div class="status">Website Upgrade in Progress</div>

    <div class="footer-text">
      Thank you for your patience and understanding.
    </div>
  </div>

  <script>
    const dots = document.getElementById("dots");
    let count = 1;

    setInterval(() => {
      count++;
      if (count > 3) count = 1;
      dots.textContent = ".".repeat(count);
    }, 500);
  </script>

</body>
</html>